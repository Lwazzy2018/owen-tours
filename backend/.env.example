# Copy to appsettings.Development.json values or set as environment variables.
# ASP.NET reads nested keys with double underscores, e.g. Supabase__Url.
# NEVER commit real values.

# Supabase → Project Settings → Database → Connection string → "Session pooler" or "Direct" (port 5432).
# If you must use the Transaction pooler (port 6543), add: ;No Reset On Close=true;Max Auto Prepare=0
ConnectionStrings__Database=Host=aws-0-af-south-1.pooler.supabase.com;Port=5432;Database=postgres;Username=postgres.YOUR_PROJECT_REF;Password=YOUR_DB_PASSWORD;SSL Mode=Require;Trust Server Certificate=true

# Supabase → Project Settings → API
Supabase__Url=https://YOUR_PROJECT_REF.supabase.co
Supabase__ServiceRoleKey=YOUR_SERVICE_ROLE_KEY            # server only!
Supabase__JwtSecret=                                       # only for older projects using the legacy JWT secret

# PayFast sandbox (https://sandbox.payfast.co.za). Public sandbox test merchant shown; use your own for live.
PayFast__UseSandbox=true
PayFast__MerchantId=10000100
PayFast__MerchantKey=46f0cd694581a
PayFast__Passphrase=
PayFast__NotifyUrl=https://YOUR-PUBLIC-API-URL/api/payments/payfast/notify
PayFast__ReturnUrl=https://YOUR-PUBLIC-API-URL/api/payments/return
PayFast__CancelUrl=https://YOUR-PUBLIC-API-URL/api/payments/cancel
PayFast__ValidateSourceIp=true
PayFast__ValidateWithServer=true
ForwardedHeaders__Enabled=false                            # true when hosted behind a proxy (Render, Railway, Azure)

# Email (optional). Without it, messages are written to the log and the notifications table.
Smtp__Host=
Smtp__Port=587
Smtp__Username=
Smtp__Password=
Smtp__FromEmail=owentours@outlook.com

# Flutter web admin origin(s)
Cors__AllowedOrigins__0=http://localhost:5000
